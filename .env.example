# Copy to .env and fill in real values. Never commit .env.

DUE_ENV=development
PORT=3000

# Session signing — use a long random string (≥32 chars in production)
AUTH_SECRET=replace-with-a-long-random-secret

# Database (omit for local PGlite tests)
# DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/due_dev

# Messaging: demo (default, safe) | email (requires Resend)
DUE_MESSAGING_PROVIDER=demo

# Required only when DUE_MESSAGING_PROVIDER=email
# RESEND_API_KEY=re_xxxxxxxx
# DUE_EMAIL_FROM=DUE <billing@your-verified-domain.example>
# DUE_EMAIL_REPLY_TO=support@your-verified-domain.example
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx

# CSRF / cookies (production defaults are strict)
# DUE_PUBLIC_ORIGIN=https://app.example.com
# DUE_SECURE_COOKIES=1
# DUE_CSRF_REQUIRE_ORIGIN=1
